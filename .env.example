TRANSPORTE_BASE_URL=https://apitransporte.buenosaires.gob.ar
TRANSPORTE_CLIENT_ID=
TRANSPORTE_CLIENT_SECRET=

# Origen principal del frontend (compatibilidad).
FRONTEND_ORIGIN=http://localhost:5173

# Lista de orígenes permitidos para CORS (acceso directo al backend).
# Separar por comas. Sin wildcards de vercel.app.
# Tras el primer deploy en Vercel, agregar el origen real, p.ej.:
#   https://nombre-proyecto.vercel.app
# Cada preview adicional debe listarse de forma explícita.
# Para LAN: agregar p.ej. http://192.168.0.123:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
